#!/usr/bin/env bash
# gpsstat — one-screen health view of the GNSS / PPS / chrony chain on the CM4.
#
# Checks the things that actually break, in the order they break. The failure of
# 2026-09-10 (dead RTC -> clock step -> gpsd silently stops writing SHM(0) ->
# both refclocks starve) is invisible from `chronyc tracking` alone, which just
# shows a healthy stratum-3 clock. This looks at every link.
#
#   gpsstat        health summary
#   gpsstat -v     also read TMODE / TP2 / cable delay back from the receiver (slow)
#   watch -n5 gpsstat   live view
#
# Exit: 0 healthy, 1 degraded, 2 GNSS timing is down.

set -uo pipefail

RC=0
if [ -t 1 ]; then
	G=$'\033[32m'; Y=$'\033[33m'; R=$'\033[31m'; B=$'\033[1m'; N=$'\033[0m'
else
	G=; Y=; R=; B=; N=
fi

ok()   { printf '  %sOK%s    %s\n'   "$G" "$N" "$*"; }
warn() { printf '  %sWARN%s  %s\n'   "$Y" "$N" "$*"; [ "$RC" -lt 1 ] && RC=1; return 0; }
fail() { printf '  %sFAIL%s  %s\n'   "$R" "$N" "$*"; RC=2; return 0; }
# note() is for known, accepted conditions: reported every run so they do not get
# forgotten, but deliberately not counted against the exit code.
note() { printf '  %sNOTE%s  %s\n'   "$B" "$N" "$*"; }
head_() { printf '\n%s%s%s\n' "$B" "$*" "$N"; }

VERBOSE=0
[ "${1:-}" = "-v" ] && VERBOSE=1

# gpsd may have more than one device attached (the receiver plus an NTRIP relay
# feeding it corrections). ubxtool must be told which one, or gpsd refuses with
# "No path specified in DEVICE, but multiple devices are attached."
F9T_TARGET="${F9T_TARGET:-localhost:2947:/dev/ttyAMA0}"

# Site baseline for the MON-RF CW interference indicator, as "block:value" pairs.
# In central Helsinki block 0 (L1/E1/B1) reads a steady 57-63 at every hour of
# the day, AGC unchanged, and the receiver classifies that as WARNING. Three days
# of dashboard history (2026-09-10..13) showed no daily pattern, with C/N0,
# satellites used and tAcc all healthy throughout. That is the site's RF floor,
# not an event: reported as a NOTE, and only a departure from it is a WARN.
# Whether it is city background or a spur from the rig's own clocks is still
# open — a UBX-MON-SPAN capture would tell.
F9T_RF_BASELINE="${F9T_RF_BASELINE:-0:60 1:7}"
F9T_RF_TOLERANCE="${F9T_RF_TOLERANCE:-15}"

TMP=$(mktemp -d) || exit 1
trap 'rm -rf "$TMP"' EXIT

# ---------------------------------------------------------------- chrony

head_ "chrony"

if ! command -v chronyc >/dev/null; then
	fail "chronyc not installed"
else
	TRACK=$(chronyc -n tracking 2>/dev/null)
	SRC=$(chronyc -n sources 2>/dev/null)
	SRC_NAMES=$(chronyc sources 2>/dev/null)

	REFID=$(awk -F': *' '/^Reference ID/{print $2}' <<<"$TRACK")
	STRATUM=$(awk -F': *' '/^Stratum/{print $2}' <<<"$TRACK")
	SYSTIME=$(awk -F': *' '/^System time/{print $2}' <<<"$TRACK")
	RMS=$(awk -F': *' '/^RMS offset/{print $2}' <<<"$TRACK")
	LEAP=$(awk -F': *' '/^Leap status/{print $2}' <<<"$TRACK")

	printf '  ref %s | stratum %s | %s | RMS %s\n' \
		"${REFID:-?}" "${STRATUM:-?}" "${SYSTIME:-?}" "${RMS:-?}"

	case "$REFID" in
		*PPS2*) ok "disciplined by PPS2 (GNSS 1 PPS via PHC)" ;;
		"")     fail "chrony is not tracking anything" ;;
		*)      warn "tracking $REFID, not PPS2 — GNSS is not steering the clock" ;;
	esac

	[ "${STRATUM:-9}" = "1" ] || warn "stratum ${STRATUM:-?}, expected 1"
	[ "${LEAP:-}" = "Normal" ] || warn "leap status ${LEAP:-?}"

	# Refclock reach. '#' prefixes local reference clocks in chronyc sources.
	while read -r line; do
		[ -z "$line" ] && continue
		name=$(awk '{print $2}' <<<"$line")
		reach=$(awk '{print $5}' <<<"$line")
		sample=$(awk '{print $7}' <<<"$line" | tr -d '[')
		if [ "$reach" = "0" ]; then
			fail "refclock $name unreachable (reach 0) — see 'gpsd' below"
		elif [ "$reach" = "377" ]; then
			ok "refclock $name reach 377, last $sample"
		else
			warn "refclock $name reach $reach (filling or lossy), last $sample"
		fi
	done < <(grep '^#' <<<"$SRC")

	if ! grep -q '^#' <<<"$SRC"; then
		fail "no refclocks configured in chrony.conf"
	fi

	# Network comparison against Finland's national time service. Keep this as a
	# stable, parseable line: the dashboard archives the adjusted offset and NTP
	# root distance, while the human-readable source names come from chrony's
	# non-numeric view. Positive offset means the local clock is ahead.
	awk '$1 ~ /^\^/ && $2 ~ /(^|\.)mikes\.fi$/ {
		offset = $7
		sub(/\[.*/, "", offset)
		printf "  chrony MIKES %s | stratum %s | reach %s | offset %s | error %s\n",
		       $2, $3, $5, offset, $NF
	}' <<<"$SRC_NAMES"
fi

# ---------------------------------------------------------------- gpsd SHM

head_ "gpsd -> chrony SHM"

if ! pgrep -x gpsd >/dev/null; then
	fail "gpsd not running"
else
	GPSD_SINCE=$(systemctl show gpsd.service -p ActiveEnterTimestamp --value 2>/dev/null)
	printf '  gpsd up since %s\n' "${GPSD_SINCE:-unknown}"

	# SHM(0) is root-owned 0600 by gpsd's design, so this needs sudo to observe.
	# chronyd itself reads it fine: it opens refclocks before dropping privileges.
	if sudo -n true 2>/dev/null; then
		sudo -n timeout 4 ntpshmmon -n 3 2>/dev/null | grep -c '^sample NTP0' >"$TMP/n" || true
		NS=$(cat "$TMP/n" 2>/dev/null || echo 0)
		if [ "${NS:-0}" -gt 0 ]; then
			ok "SHM(0) live — $NS samples in 4 s"
		else
			fail "gpsd is NOT writing SHM(0) — run: sudo systemctl restart gpsd"
		fi
	else
		warn "no passwordless sudo; cannot read SHM(0) directly"
	fi
fi

# ---------------------------------------------------------------- GNSS fix

head_ "GNSS fix"

# Collect for a fixed time, not a fixed message count. "-n 40" inside an 8 s
# timeout was right at the edge: the stream yields roughly 5-7 JSON objects a
# second, so 40 of them needs 6-8 s, and any slight slowdown — another gpsstat
# running from cron at the same moment — returned nothing and reported "GNSS
# timing is down" on a rig sitting at 9 ns RMS. A monitor that cries failure at a
# healthy system trains you to ignore it.
if timeout 15 gpspipe -w -x 9 >"$TMP/gps.json" 2>/dev/null && [ -s "$TMP/gps.json" ]; then
	TPV=$(jq -c 'select(.class=="TPV")' <"$TMP/gps.json" 2>/dev/null | tail -1)

	# gpsd emits several kinds of SKY for the F9T, and which one arrives last in the
	# window depends on the receiver's message set: NAV-PVT/DOP ones with uSat and DOPs
	# but no satellite list, a NAV-SAT one with one entry per satellite, and, while
	# NMEA GSV is on, a run of GSV-built ones with one entry per signal (L1/L2/E5b)
	# that grow through the cycle and can repeat a constellation. Taking simply the
	# last SKY with uSat read "0 seen / C/N0 0" whenever a list-less one came last
	# (2026-09-15, after the F9T power cycle put NMEA back on). So: prefer the last
	# per-satellite list, else any list, and collapse it to one entry per satellite.
	SKYS=$(jq -c 'select(.class=="SKY" and ((.satellites // []) | length) > 0)' <"$TMP/gps.json" 2>/dev/null)
	SKY=$(jq -c 'select([.satellites[] | select(.sigid != null)] | length == 0)' <<<"${SKYS:-}" 2>/dev/null | tail -1)
	[ -n "${SKY:-}" ] || SKY=$(tail -1 <<<"${SKYS:-}")
	DOPSKY=$(jq -c 'select(.class=="SKY" and .pdop != null)' <"$TMP/gps.json" 2>/dev/null | tail -1)
	SATS=$(jq -c '[.satellites[]? | {k: [(.gnssid // 0), .svid], used: (.used == true), ss: (.ss // 0)}]
	              | group_by(.k) | map({gnssid: .[0].k[0], used: (map(.used) | any), ss: (map(.ss) | max)})' \
	          <<<"${SKY:-\{\}}" 2>/dev/null)

	MODE=$(jq -r '.mode // 0'   <<<"${TPV:-\{\}}" 2>/dev/null)
	GTIME=$(jq -r '.time // "-"' <<<"${TPV:-\{\}}" 2>/dev/null)
	LEAPS=$(jq -r '.leapseconds // "-"' <<<"${TPV:-\{\}}" 2>/dev/null)
	USAT=$(jq -r 'map(select(.used)) | length' <<<"${SATS:-[]}" 2>/dev/null)
	NSAT=$(jq -r 'length' <<<"${SATS:-[]}" 2>/dev/null)
	# No satellite list at all: fall back to the PVT count so the used-satellites check still runs.
	[ "${NSAT:-0}" -gt 0 ] || USAT=$(jq -r '.uSat // 0' <<<"${DOPSKY:-\{\}}" 2>/dev/null)
	PDOP=$(jq -r '.pdop // "-"' <<<"${DOPSKY:-\{\}}" 2>/dev/null)
	TDOP=$(jq -r '.tdop // "-"' <<<"${DOPSKY:-\{\}}" 2>/dev/null)

	printf '  time %s | leap %s | sats %s used / %s seen | PDOP %s TDOP %s\n' \
		"$GTIME" "$LEAPS" "$USAT" "$NSAT" "$PDOP" "$TDOP"

	# Which constellations are actually contributing, not merely enabled. u-blox
	# gnssId: 0 GPS, 1 SBAS, 2 Galileo, 3 BeiDou, 4 IMES, 5 QZSS, 6 GLONASS.
	if [ -n "${SKY:-}" ]; then
		CONST=""
		while IFS=: read -r gid n; do
			[ -z "$gid" ] && continue
			case "$gid" in
				0) gname=GPS ;;     1) gname=SBAS ;;    2) gname=Galileo ;;
				3) gname=BeiDou ;;  4) gname=IMES ;;    5) gname=QZSS ;;
				6) gname=GLONASS ;; *) gname="gnss$gid" ;;
			esac
			CONST="$CONST  $gname $n"
		done < <(jq -r 'map(select(.used)) | group_by(.gnssid)
		                | map("\(.[0].gnssid):\(length)") | .[]' <<<"$SATS" 2>/dev/null)
		printf '  constellations in solution:%s\n' "${CONST:-  none}"
	fi

	case "$MODE" in
		3) ok "3D fix" ;;
		2) warn "2D fix only" ;;
		*) fail "no fix (mode $MODE)" ;;
	esac

	# With GPS, Galileo and BeiDou this rig uses 17-35 satellites (history to
	# 2026-09-13). Falling under 12 while the fix holds is what partial jamming or a
	# newly blocked sky looks like, well before the fix itself is lost.
	if [ "${USAT:-0}" -lt 6 ]; then
		warn "only ${USAT} satellites used — check antenna siting/sky view"
	elif [ "$USAT" -lt 12 ]; then
		warn "only ${USAT} satellites used, normally 17+ — interference or blocked sky"
	fi

	# Carrier-to-noise of the satellites actually in the solution. Peak here is
	# 43-48 dB-Hz. Jamming raises the noise floor, so it shows as this falling long
	# before the fix goes: the threshold sits just under the healthy range rather
	# than down at indoor-antenna levels.
	if [ -n "${SKY:-}" ]; then
		CN0=$(jq -r '[.[] | select(.used) | .ss] | sort | reverse | .[0:4] | map(tostring) | join(" ")' <<<"$SATS" 2>/dev/null)
		BEST=$(jq -r '[.[] | select(.used) | .ss] | max // 0' <<<"$SATS" 2>/dev/null)
		printf '  best C/N0 (used): %s dB-Hz\n' "${CN0:-?}"
		awk -v b="${BEST:-0}" 'BEGIN{exit !(b>=40)}' && ok "signal level healthy" \
			|| warn "peak C/N0 ${BEST} dB-Hz is low — jamming, or antenna/cable fault"
	fi
else
	fail "gpsd returned no data on the socket"
fi

# ---------------------------------------------------------------- interference

head_ "GNSS interference"

# MON-RF is polled read-only. Each RF block has a receiver-classified jamming
# state plus the raw 0..255 continuous-wave interference indicator. Keep both:
# the state is immediately useful, while the raw value makes trends visible.
# The receiver's state alone is not judged where a site baseline exists: block 1
# also flips to WARNING at indicator 5-9, so the state is a coarse hint, and
# block 0 sits at WARNING permanently here (see F9T_RF_BASELINE).
RF_RAW=$(UBXOPTS="-P 29.00" timeout 8 ubxtool -p MON-RF "$F9T_TARGET" 2>/dev/null)
RF_BLOCKS=0
RF_ID=''; RF_FLAGS=''
while IFS= read -r line; do
	if [[ $line =~ blockId[[:space:]]+([0-9]+)[[:space:]]+flags[[:space:]]+x([[:xdigit:]]+) ]]; then
		RF_ID=${BASH_REMATCH[1]}
		RF_FLAGS=${BASH_REMATCH[2]}
	elif [ -n "$RF_ID" ] && [[ $line =~ noisePerMS[[:space:]]+([0-9]+)[[:space:]]+agcCnt[[:space:]]+([0-9]+)[[:space:]]+jamInd[[:space:]]+([0-9]+) ]]; then
		NOISE=${BASH_REMATCH[1]}; AGC=${BASH_REMATCH[2]}; JAM=${BASH_REMATCH[3]}
		JSTATE=$((16#$RF_FLAGS & 3))
		case "$JSTATE" in
			0) JNAME=unknown ;; 1) JNAME=ok ;; 2) JNAME=warning ;; 3) JNAME=critical ;;
		esac
		printf '  RF block %s | jamming %s | indicator %s/255 | AGC %s | noise %s\n' \
			"$RF_ID" "$JNAME" "$JAM" "$AGC" "$NOISE"
		BASE=''
		for pair in $F9T_RF_BASELINE; do
			[ "${pair%%:*}" = "$RF_ID" ] && BASE=${pair#*:}
		done
		DEV=''
		[ -n "$BASE" ] && DEV=$(( JAM > BASE ? JAM - BASE : BASE - JAM ))
		if [ "$JSTATE" = 3 ]; then
			fail "RF block $RF_ID receiver jamming state is CRITICAL"
		elif [ "$JSTATE" = 0 ]; then
			warn "RF block $RF_ID jamming monitor unavailable"
		elif [ -n "$DEV" ] && [ "$DEV" -gt "$F9T_RF_TOLERANCE" ]; then
			warn "RF block $RF_ID indicator $JAM/255 departs from site baseline $BASE±$F9T_RF_TOLERANCE (state $JNAME)"
		elif [ "$JSTATE" = 2 ]; then
			if [ -n "$BASE" ]; then
				note "RF block $RF_ID state WARNING at indicator $JAM/255, within site baseline $BASE±$F9T_RF_TOLERANCE"
			else
				warn "RF block $RF_ID receiver jamming state is WARNING"
			fi
		fi
		RF_BLOCKS=$((RF_BLOCKS + 1)); RF_ID=''; RF_FLAGS=''
	fi
done <<<"$RF_RAW"
[ "$RF_BLOCKS" -gt 0 ] || warn "could not read UBX-MON-RF interference monitor"

# NAV-STATUS flags2 bits 3..4 are the receiver spoof-detection state. This is an
# indicator, not proof that a signal is authentic: report its exact semantics.
NAV_RAW=$(UBXOPTS="-P 29.00" timeout 8 ubxtool -p NAV-STATUS "$F9T_TARGET" 2>/dev/null)
FLAGS2=$(grep -A1 'UBX-NAV-STATUS:' <<<"$NAV_RAW" \
	| grep -oE 'flags2 (0)?x[0-9a-fA-F]+' | tail -1 | sed 's/.*x//')
if [ -n "$FLAGS2" ]; then
	SSTATE=$(((16#$FLAGS2 >> 3) & 3))
	case "$SSTATE" in
		0) SNAME=deactivated;      printf '  spoof detection | state %s | code %s\n' "$SNAME" "$SSTATE"; warn "receiver spoof detection is deactivated" ;;
		1) SNAME=none-indicated;   printf '  spoof detection | state %s | code %s\n' "$SNAME" "$SSTATE"; ok "receiver reports no spoofing indicated" ;;
		2) SNAME=indicated;        printf '  spoof detection | state %s | code %s\n' "$SNAME" "$SSTATE"; fail "receiver indicates possible GNSS spoofing" ;;
		3) SNAME=multiple-indicated; printf '  spoof detection | state %s | code %s\n' "$SNAME" "$SSTATE"; fail "receiver indicates multiple GNSS spoofing detections" ;;
	 esac
else
	warn "could not read UBX-NAV-STATUS spoof detector"
fi

# ---------------------------------------------------------------- accuracy

head_ "accuracy"

# Receiver's own estimate, from UBX-NAV-TIMEGPS. Read-only: -w just decodes the
# 1 Hz stream, it does not poll the receiver. NAV-PVT also carries a tAcc and it
# is a different, looser number, so anchor the grep to the TIMEGPS block.
TACC=$(export UBXOPTS="-P 29.00"; timeout 6 ubxtool -w 4 "$F9T_TARGET" 2>/dev/null \
	| grep -A1 'UBX-NAV-TIMEGPS' | grep -oE 'tAcc [0-9]+' | tail -1 | awk '{print $2}')
if [ -n "${TACC:-}" ]; then
	printf '  receiver time accuracy (NAV-TIMEGPS tAcc) : %s ns\n' "$TACC"
	[ "$TACC" -le 50 ] && ok "receiver time solution tight" \
		|| warn "receiver tAcc ${TACC} ns is loose for a timing receiver"
else
	warn "could not read NAV-TIMEGPS tAcc"
fi

# chrony's view. Std Dev on PPS2 is the honest short-term number; RMS offset in
# `tracking` is a long decay average and stays large for hours after a step.
STATS=$(chronyc -n sourcestats 2>/dev/null | awk '$1=="PPS2"{print $7, $8}')
if [ -n "${STATS:-}" ]; then
	printf '  chrony PPS2 offset / std dev              : %s\n' "$STATS"
fi

# Bound chrony guarantees on the system clock: dispersion plus half the round trip.
if [ -n "${TRACK:-}" ]; then
	RD=$(awk -F': *' '/^Root delay/{print $2+0}' <<<"$TRACK")
	RDISP=$(awk -F': *' '/^Root dispersion/{print $2+0}' <<<"$TRACK")
	MAXERR=$(awk -v d="${RD:-0}" -v p="${RDISP:-0}" 'BEGIN{printf "%.9f", p + d/2}')
	printf '  system clock max error (disp + delay/2)   : %s s\n' "$MAXERR"
	printf '  chrony RMS offset (long-term average)     : %s\n' "${RMS:-?}"
fi

# ------------------------------------------------------- reference oscillator

head_ "reference oscillator (AR-40A)"

# The CM4's crystal is removed and XIN is fed 54 MHz from the Si5351, which is
# phase-locked to the AR-40A (PLLA = 10 MHz x 86.4 = 864 MHz, MS4 /16 = 54 MHz;
# 86 + 2/5 is an exact rational, so the divider chain contributes no frequency
# error of its own). The BCM2711 arch timer runs off XIN, so the system clock's
# whole timebase is the rubidium.
#
# chrony measures the GNSS PPS against that clock. Its frequency estimate is
# therefore a direct, continuous measurement of the AR-40A against UTC — not an
# approximation of one. Free frequency comparator, by accident of topology.
#
# What it cannot see: anything below about a day of averaging. At 28 ns of PPS
# noise the measurement floor is ~5e-8 at 1 s, falling as 1/tau, while the
# rubidium sits near 1e-11 at 1 s. Every tau where a rubidium is interesting is
# buried in GNSS noise. Frequency accuracy and aging are what this measures.

# Source precision matters here. `chronyc tracking` prints ppm to three decimals,
# i.e. 1e-9 in fractional terms, which is coarser than the quantity being
# measured and makes the skew read as a flat zero. The drift file carries six
# decimals, so 1e-12, at the cost of being rewritten only periodically — fine for
# something that moves as slowly as a rubidium's frequency.

# Live figure from `tracking`: "Frequency : 0.003 ppm slow" — magnitude plus a
# direction word. Slow means the clock would lose time, i.e. the reference is low
# in frequency. Used below as the fallback, and by the integrity check.
LIVE_FRAC=""
FREQ_RAW=$(awk -F': *' '/^Frequency/{print $2}' <<<"${TRACK:-}")
if [ -n "$FREQ_RAW" ]; then
	LIVE_FRAC=$(awk -v s="$FREQ_RAW" 'BEGIN{
		n = s + 0
		if (s ~ /slow/) n = -n
		printf "%.4e", n * 1e-6 }')
fi

DRIFT=/var/lib/chrony/chrony.drift
DRIFT_TXT=""
sudo -n test -r "$DRIFT" 2>/dev/null && DRIFT_TXT=$(sudo -n cat "$DRIFT" 2>/dev/null)

if [ -n "$DRIFT_TXT" ]; then
	FRAC=$(awk '{ printf "%.4e", $1 * 1e-6 }' <<<"$DRIFT_TXT")
	SKEWF=$(awk '{ printf "%.2e", $2 * 1e-6 }' <<<"$DRIFT_TXT")
	DRIFT_AGE=$(( ( $(date +%s) - $(sudo -n stat -c %Y "$DRIFT" 2>/dev/null || echo 0) ) / 60 ))

	printf '  fractional frequency offset vs GNSS       : %s\n' "$FRAC"
	printf '  frequency uncertainty (chrony skew)       : %s\n' "$SKEWF"
	printf '  drift file age                            : %s min\n' "$DRIFT_AGE"
elif [ -n "$LIVE_FRAC" ]; then
	SKEW_RAW=$(awk -F': *' '/^Skew/{print $2}' <<<"$TRACK")
	FRAC=$LIVE_FRAC
	SKEWF=$(awk -v s="$SKEW_RAW" 'BEGIN{ printf "%.2e", (s + 0) * 1e-6 }')

	printf '  fractional frequency offset vs GNSS       : %s\n' "$FRAC"
	printf '  frequency uncertainty (chrony skew)       : %s\n' "$SKEWF"
else
	FRAC=""
	warn "no chrony frequency data for the reference oscillator"
fi

# Judged outside the branches above so the verdict is reached whichever source
# supplied the number. Only meaningful when GNSS is actually steering: against a
# network source the same figure is real but far too noisy to conclude from.
if [ -n "${FRAC:-}" ]; then
	ABSFRAC=$(awk -v f="$FRAC" 'BEGIN{ printf "%.4e", (f < 0 ? -f : f) }')

	# The fractional offset restated as the thing it actually costs. GNSS supplies
	# accuracy while it is present, and 1e-9 is invisible to the Orion (audio wants
	# ppm) and to bench instruments, so this offset shows up in exactly one place:
	# how fast the rig walks away from UTC if GNSS is lost.
	printf '  holdover drift if GNSS is lost            : %s us/day\n' \
		"$(awk -v a="$ABSFRAC" 'BEGIN{ printf "%.1f", a * 86400 * 1e6 }')"

	# Mechanical trim is 10 turns over 5e-9 total, i.e. ~5e-10 per turn (docs/hardware.md).
	# Printed as turns because that is the unit the adjustment is made in. Whether
	# the turns are *available* depends on where the trimmer currently sits, which
	# is not recorded anywhere — see plan.md before opening the case.
	printf '  mechanical trim to null this              : %s turns of 10\n' \
		"$(awk -v a="$ABSFRAC" 'BEGIN{ printf "%.2f", a / 5e-10 }')"
	case "${REFID:-}" in
		*PPS2*)
			if awk -v a="$ABSFRAC" 'BEGIN{ exit !(a < 1e-8) }'; then
				ok "reference within 1e-8 of GNSS"
			elif awk -v a="$ABSFRAC" 'BEGIN{ exit !(a < 1e-7) }'; then
				note "offset above 1e-8 — aged, untrimmed, or still settling"
			else
				warn "offset above 1e-7 — check the AR-40A has lock"
			fi
			;;
		*)  note "not disciplined by GNSS; frequency figure is not meaningful" ;;
	esac
fi

# ------------------------------------------------------- GNSS vs the rubidium

# The receiver's spoof flag is weak. The AR-40A is not: a spoofer can move GNSS
# time but not the rubidium the system clock runs from, so whatever it does has to
# show up in chrony — first as a phase step on PPS2, then, once chrony follows, as
# a clock frequency that no longer matches the rubidium's.
#
# Frequency uses the live `tracking` figure, not the drift file, which is
# rewritten only periodically and would report a pull long after it started. The
# rubidium sits within ~3e-9 of GNSS (history to 2026-09-13), so past 2e-8
# (1.7 ms/day) it is GNSS that is moving: spoofing, or a receiver fault. The
# phase limit is 1 us against a PPS2 offset that runs 20-40 ns. A slow walk under
# both limits is not caught here; the MIKES comparison and the long-term
# frequency history are what would show that.
case "${REFID:-}" in
	*PPS2*)
		head_ "GNSS integrity vs rubidium"
		if [ -n "$LIVE_FRAC" ]; then
			printf '  live frequency offset vs GNSS             : %s\n' "$LIVE_FRAC"
			if awk -v f="$LIVE_FRAC" 'BEGIN{ exit !((f < 0 ? -f : f) > 2e-8) }'; then
				warn "clock frequency $LIVE_FRAC is far off the rubidium's — GNSS time is being pulled"
			else
				ok "GNSS frequency agrees with the rubidium"
			fi
		else
			warn "no live chrony frequency to compare GNSS against the rubidium"
		fi

		PPS_NS=$(awk -v s="${STATS%% *}" 'BEGIN{
			u = s; sub(/^[-+0-9.]+/, "", u)
			m = (u == "ns") ? 1 : (u == "us") ? 1e3 : (u == "ms") ? 1e6 : (u == "s") ? 1e9 : 0
			if (!m) exit 1
			printf "%.0f", s * m }')
		if [ -n "$PPS_NS" ]; then
			if [ "${PPS_NS#-}" -gt 1000 ]; then
				warn "PPS2 offset ${STATS%% *} from the rubidium-held clock — GNSS time stepped"
			else
				ok "PPS2 phase consistent with the rubidium-held clock"
			fi
		fi
		;;
esac

# --------------------------------------------------------------- reminders

# Date-gated notes. They live here because gpsstat already runs every five
# minutes from cron and feeds the dashboard, so whatever it prints gets seen —
# which is more reliable than anyone remembering. NOTE level deliberately: a
# reminder must never push the exit code non-zero, or a real failure stops
# standing out.
#
# Format, one per line:  YYYY-MM-DD|message
REMINDERS="${F9T_REMINDERS:-$HOME/.config/f9t-reminders}"
if [ -r "$REMINDERS" ]; then
	today=$(date +%Y-%m-%d)
	shown=0
	while IFS="|" read -r due msg; do
		case "$due" in ""|\#*) continue ;; esac
		[ -z "${msg:-}" ] && continue
		# due <= today, as string comparison, which ISO dates make valid
		if [ ! "$due" \> "$today" ]; then
			[ "$shown" = "0" ] && head_ "reminders"
			shown=1
			note "due $due: $msg"
		fi
	done <"$REMINDERS"
fi

# ---------------------------------------------------------------- hardware

head_ "hardware / boot"

# The RTC is the root of the 2026-09-10 failure: no backup cell -> bogus boot
# time -> chrony steps by years -> gpsd stops feeding SHM.
if sudo -n true 2>/dev/null; then DMESG="sudo -n dmesg"; else DMESG="dmesg"; fi
# grep -c, not grep -q: under `pipefail` an early-exiting grep -q kills dmesg with
# SIGPIPE and the whole pipeline reports failure, so the test never fires.
RTC_POWERLOSS=$($DMESG 2>/dev/null | grep -c 'rtc.*Power loss detected' || true)
if [ "${RTC_POWERLOSS:-0}" -gt 0 ]; then
	# Known and accepted: a cell is on the list. Reported, not counted, so the exit
	# code stays meaningful for the things that are actually news.
	note "RTC has no backup cell — clock steps at every cold boot, which is what"
	printf '        silently kills gpsd SHM. Restart gpsd after a cold boot until fixed.\n'
elif [ "$(cat /sys/class/rtc/rtc0/hctosys 2>/dev/null || echo 0)" = "1" ]; then
	ok "system clock was set from the RTC at boot"
else
	warn "RTC did not set the system clock at boot (run with sudo access for the reason)"
fi

if systemctl is-active --quiet ser2net 2>/dev/null; then
	fail "ser2net is active — it contends with gpsd for /dev/ttyAMA0"
else
	ok "ser2net inactive (no contention on /dev/ttyAMA0)"
fi

# PPS arrives at the Ethernet PHY's timestamp input, not as /dev/pps0.
PHC=$(cat /sys/class/ptp/ptp0/clock_name 2>/dev/null || echo "")
if [ "$PHC" = "bcm_phy_ptp" ]; then
	ok "PHC /dev/ptp0 is $PHC (PPS via BCM54210PE external timestamp)"
else
	warn "PHC /dev/ptp0 reports '${PHC:-missing}', expected bcm_phy_ptp"
fi

# ---------------------------------------------------------------- receiver

if [ "$VERBOSE" = "1" ]; then
	head_ "receiver config (polled)"
	export UBXOPTS="-P 29.00"
	timeout 25 ubxtool -g CFG-TMODE,0 "$F9T_TARGET" 2>/dev/null \
		| grep -iE 'CFG-TMODE-(MODE|POS_TYPE|HEIGHT|LAT|LON)/' | sed 's/^ */  /'
	timeout 25 ubxtool -g CFG-TP,0 "$F9T_TARGET" 2>/dev/null \
		| grep -iE 'CFG-TP-(PULSE_DEF|ANT_CABLEDELAY|PERIOD_TP2|LEN_TP2|USE_LOCKED_TP2|TP2_ENA)/' | sed 's/^ */  /'
	# Per-signal enables, not the per-constellation master switches: a constellation
	# whose master switch is on but whose every signal is off contributes nothing.
	printf '  signals enabled:'
	timeout 25 ubxtool -g CFG-SIGNAL,0 "$F9T_TARGET" 2>/dev/null \
		| awk '/CFG-SIGNAL-.*_ENA\/.* val 1/ {
			match($0, /CFG-SIGNAL-[A-Z0-9_]+_ENA/);
			n = substr($0, RSTART+11, RLENGTH-15);
			if (n !~ /^(GPS|SBAS|GAL|BDS|QZSS|GLO)$/) printf " %s", n }'
	echo
fi

# ---------------------------------------------------------------- verdict

head_ "verdict"
case "$RC" in
	0) printf '  %sGNSS timing chain healthy%s\n' "$G" "$N" ;;
	1) printf '  %sdegraded — see WARN above%s\n' "$Y" "$N" ;;
	2) printf '  %sGNSS timing is down — see FAIL above%s\n' "$R" "$N" ;;
esac
echo
exit "$RC"
