#!/usr/bin/env python3
"""ntrip-relay — pull RTCM from an NTRIP caster, serve it on a local TCP port.

Why this exists rather than gpsd's own ntrip:// support: gpsd validates the
stream format against a table in ntrip.c, and that table has "RTCM 3.2" (with a
space) and "RTCM32" but not "RTCM3.2", which is exactly the string the
Maanmittauslaitos caster advertises for DGNSS-MSM1. gpsd therefore refuses a
stream it is perfectly capable of handling:

    NTRIP: Got unknown format 'RTCM3.2'
    NTRIP: stream STR;DGNSS-MSM1 format not supported

So this pulls the stream from the real caster and re-serves it locally as a
minimal NTRIP caster of its own, advertising the identical data under the
spelling gpsd accepts. gpsd then connects with ntrip:// and takes its normal
correction path.

Two other routes were tried and do not work. A plain tcp:// device is never
relayed: gpsd gates the RTCM relay on the device's *service type*, not on the
packet type, so the bytes arrive and stop there. And dgpsip:// drops the port
from the URL and expects a handshake of its own.

It also keeps the caster password out of gpsd's command line and out of
/etc/default/gpsd, where it would otherwise sit in a world-readable file and in
the output of ps. The local caster takes no password.

Usage:
    ntrip-relay --password-file ~/.dgnss --user mkovero \
                --caster opencaster.nls.fi --port 2102 \
                --mount DGNSS-MSM1 --listen 5757 \
                --lat 60.1796447 --lon 24.9586922 --alt 19.0

then point gpsd at it:  ntrip://127.0.0.1:5757/DGNSS-MSM1

The position is only used for the periodic GGA sent upstream, which is how the
caster picks the nearest reference station. Approximate is fine — it selects a
base, it does not enter the solution.
"""

import argparse
import base64
import datetime
import os
import select
import socket
import sys
import threading
import time

BUFSZ = 4096


def log(msg):
    print(f"[{datetime.datetime.now().strftime('%H:%M:%S')}] {msg}", flush=True)


def nmea_gga(lat, lon, alt):
    """Build a GGA sentence for the caster's nearest-station routing."""
    now = datetime.datetime.now(datetime.timezone.utc)
    hhmmss = now.strftime("%H%M%S.00")

    def dm(v, is_lat):
        hemi = ("N" if v >= 0 else "S") if is_lat else ("E" if v >= 0 else "W")
        v = abs(v)
        deg = int(v)
        minutes = (v - deg) * 60.0
        width = 2 if is_lat else 3
        return f"{deg:0{width}d}{minutes:09.6f}", hemi

    lat_s, ns = dm(lat, True)
    lon_s, ew = dm(lon, False)
    body = (f"GPGGA,{hhmmss},{lat_s},{ns},{lon_s},{ew},"
            f"1,12,1.0,{alt:.1f},M,0.0,M,,")
    ck = 0
    for c in body:
        ck ^= ord(c)
    return f"${body}*{ck:02X}\r\n".encode("ascii")


class Relay:
    def __init__(self, args, password):
        self.a = args
        self.password = password
        self.clients = []
        self.lock = threading.Lock()
        self.bytes_in = 0
        self.last_data = 0.0
        self.serial_fd = None

    # ---------------------------------------------------------------- caster

    def connect_caster(self):
        a = self.a
        auth = base64.b64encode(
            f"{a.user}:{self.password}".encode()).decode("ascii")
        req = (
            f"GET /{a.mount} HTTP/1.1\r\n"
            f"Host: {a.caster}:{a.port}\r\n"
            f"Ntrip-Version: Ntrip/2.0\r\n"
            f"User-Agent: NTRIP ntrip-relay/1.0\r\n"
            f"Authorization: Basic {auth}\r\n"
            f"Connection: close\r\n"
            f"\r\n"
        ).encode("ascii")

        s = socket.create_connection((a.caster, a.port), timeout=20)
        s.sendall(req)

        # Read just the response header, keeping any body bytes that follow.
        buf = b""
        while b"\r\n\r\n" not in buf:
            chunk = s.recv(BUFSZ)
            if not chunk:
                raise ConnectionError("caster closed during handshake")
            buf += chunk
            if len(buf) > 65536:
                raise ConnectionError("no end of headers")
        head, _, rest = buf.partition(b"\r\n\r\n")
        first = head.split(b"\r\n")[0].decode("ascii", "replace")

        if b"200" not in head.split(b"\r\n")[0]:
            # Never echo the request: it carries the Authorization header.
            raise ConnectionError(f"caster refused: {first}")
        log(f"connected: {first}")
        return s, rest

    # ---------------------------------------------------------------- server
    #
    # The local end is a minimal NTRIP caster rather than a raw socket. gpsd will
    # not relay RTCM from a plain tcp:// device — the relay is gated on the
    # device's service type, not on the packet type — and its dgpsip:// path
    # discards the port and uses a handshake of its own. Speaking NTRIP back to
    # gpsd puts us on the code path actually built for corrections.
    #
    # The one substantive difference from upstream is the advertised format:
    # gpsd's table accepts "RTCM 3.2" but not "RTCM3.2", which is what the real
    # caster sends. Re-advertising the same stream under the spelling gpsd knows
    # is the whole trick.

    def sourcetable(self):
        m = self.a.mount
        return (
            f"STR;{m};{m};RTCM 3.2;1006(10),1071(1),1081(1),1091(1),1121(1);"
            f"0;GPS+GLO+GAL+BDS;NLS;FIN;60.18;24.96;0;0;ntrip-relay;none;B;N;"
            f"1000;\r\n"
            "ENDSOURCETABLE\r\n"
        )

    def handle_client(self, c, addr):
        """Read the NTRIP request and either answer it or enroll a streamer."""
        c.settimeout(10)
        try:
            buf = b""
            while b"\r\n\r\n" not in buf and len(buf) < 8192:
                chunk = c.recv(1024)
                if not chunk:
                    c.close()
                    return
                buf += chunk
        except OSError:
            c.close()
            return

        line = buf.split(b"\r\n")[0].decode("ascii", "replace")
        parts = line.split()
        path = parts[1] if len(parts) > 1 else "/"

        if path in ("/", ""):
            body = self.sourcetable()
            c.sendall(
                ("SOURCETABLE 200 OK\r\n"
                 "Server: ntrip-relay/1.0\r\n"
                 "Content-Type: text/plain\r\n"
                 f"Content-Length: {len(body)}\r\n"
                 "\r\n" + body).encode("ascii"))
            c.close()
            log(f"served sourcetable to {addr[0]}")
            return

        want = path.lstrip("/")
        if want != self.a.mount:
            c.sendall(b"HTTP/1.1 404 Not Found\r\n\r\n")
            c.close()
            log(f"404 for mount '{want}' from {addr[0]}")
            return

        c.sendall(b"ICY 200 OK\r\n\r\n")
        c.settimeout(None)
        c.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
        with self.lock:
            self.clients.append(c)
        log(f"streaming to {addr[0]}:{addr[1]}")

    def serve(self):
        srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        srv.bind((self.a.bind, self.a.listen))
        srv.listen(4)
        log(f"caster listening on {self.a.bind}:{self.a.listen}/{self.a.mount}")
        while True:
            try:
                c, addr = srv.accept()
            except OSError:
                continue
            threading.Thread(target=self.handle_client,
                             args=(c, addr), daemon=True).start()

    # ------------------------------------------------------------- serial sink
    #
    # gpsd will relay RTCM, but it drops 1006 and 1008 — the reference station
    # ARP and antenna descriptor — while passing every other message through.
    # Without the base coordinates the receiver cannot form a differential
    # solution, so UBX-NAV-PVT keeps reporting flags=0x1 (diffSoln clear) even
    # though UBX-RXM-RTCM shows the observation messages arriving with good CRC.
    #
    # Writing straight to the receiver's port sidesteps that. It does not fight
    # gpsd: gpsd runs with --passive, so it never writes to the port itself, and
    # a second writer on a tty someone else is reading is harmless.

    def open_serial(self):
        if not self.a.serial:
            return
        try:
            self.serial_fd = os.open(self.a.serial, os.O_WRONLY | os.O_NOCTTY)
            log(f"writing RTCM directly to {self.a.serial}")
        except OSError as e:
            log(f"cannot open {self.a.serial}: {e}")
            self.serial_fd = None

    def to_serial(self, data):
        if self.serial_fd is None:
            return
        try:
            os.write(self.serial_fd, data)
        except OSError as e:
            log(f"serial write failed: {e}; reopening")
            try:
                os.close(self.serial_fd)
            except OSError:
                pass
            self.serial_fd = None
            self.open_serial()

    def fanout(self, data):
        self.to_serial(data)
        with self.lock:
            dead = []
            for c in self.clients:
                try:
                    c.sendall(data)
                except OSError:
                    dead.append(c)
            for c in dead:
                log("client went away")
                try:
                    c.close()
                except OSError:
                    pass
                self.clients.remove(c)

    # ------------------------------------------------------------------ main

    def run(self):
        self.open_serial()
        threading.Thread(target=self.serve, daemon=True).start()

        backoff = 2
        while True:
            try:
                s, rest = self.connect_caster()
                backoff = 2
                if rest:
                    self.bytes_in += len(rest)
                    self.fanout(rest)

                gga = nmea_gga(self.a.lat, self.a.lon, self.a.alt)
                s.sendall(gga)
                last_gga = time.time()
                last_report = time.time()

                while True:
                    r, _, _ = select.select([s], [], [], 5.0)
                    if r:
                        data = s.recv(BUFSZ)
                        if not data:
                            raise ConnectionError("caster closed the stream")
                        self.bytes_in += len(data)
                        self.last_data = time.time()
                        self.fanout(data)

                    now = time.time()
                    # The caster drops idle clients and needs GGA to keep
                    # choosing a base station as time passes.
                    if now - last_gga > self.a.gga_interval:
                        s.sendall(nmea_gga(self.a.lat, self.a.lon, self.a.alt))
                        last_gga = now
                    if now - last_report > 60:
                        with self.lock:
                            nc = len(self.clients)
                        log(f"{self.bytes_in} bytes from caster, "
                            f"{nc} client(s)")
                        last_report = now
                    if self.last_data and now - self.last_data > 60:
                        raise ConnectionError("no data for 60 s")

            except Exception as e:                       # noqa: BLE001
                log(f"caster error: {e}; retrying in {backoff}s")
                try:
                    s.close()
                except Exception:                        # noqa: BLE001
                    pass
                time.sleep(backoff)
                backoff = min(backoff * 2, 60)


def main():
    p = argparse.ArgumentParser()
    p.add_argument("--caster", default="opencaster.nls.fi")
    p.add_argument("--port", type=int, default=2102)
    p.add_argument("--mount", default="DGNSS-MSM1")
    p.add_argument("--user", required=True)
    p.add_argument("--password-file", required=True)
    p.add_argument("--listen", type=int, default=5757)
    p.add_argument("--bind", default="127.0.0.1")
    p.add_argument("--lat", type=float, required=True)
    p.add_argument("--lon", type=float, required=True)
    p.add_argument("--alt", type=float, default=0.0)
    p.add_argument("--gga-interval", type=float, default=10.0)
    p.add_argument("--serial", default=None,
                   help="also write RTCM straight to this device, "
                        "bypassing gpsd's relay (which drops 1006/1008)")
    a = p.parse_args()

    path = os.path.expanduser(a.password_file)
    with open(path) as fh:
        password = fh.read().strip()
    if not password:
        sys.exit(f"{path} is empty")

    Relay(a, password).run()


if __name__ == "__main__":
    main()
