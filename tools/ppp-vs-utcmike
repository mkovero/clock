#!/usr/bin/env python3
"""ppp-vs-utcmike — compare our PPP receiver-clock solution against UTC(MIKE).

MIKES submits PPP time-transfer files to the BIPM (CGGTTS-style, PRN 99 rows, 5-minute
values of REFGPS = UTC(MIKE) - GPS time, in ns). They are public, and their station is
calibrated (Cal_Id in the header), so differencing our own PPP clock against theirs gives

    ours - theirs = (our receiver clock) - UTC(MIKE)

over the same epochs, with satellite orbit and clock errors largely common to both.

**Read this before trusting the output.** Measured 2026-09-30 on a CSRS-PPP .clk from this
station: the receiver clock PPP solves for is the F9T's *free-running TCXO*, +589 us to
-11222 us over 23 h, drifting -0.141 ppm. MIKES's REFGPS is tens of ns. Differencing the two
as-is measures our crystal, not our timing output, and is useless for calibration.

To make the comparison mean something, the PPS has to be tied to GPS time. The receiver places
its pulse using its *own* estimate of its clock bias, and misses by qErr; PPP measures the same
bias independently. With both as receiver clock - GPS time:

    PPS - GPS time = (receiver's bias, ubx-rxclock) - (PPP's bias, .clk AR) - qErr (TIM-TP)

The TCXO's offset and drift are in both biases and cancel; nothing is fitted. The version of
this before 2026-10-08 tried to tie TIM-TP straight to the PPP clock and guess the sign from
which one cancelled the drift; neither sign could, and docs/pulse-to-gps-tie.md has why.

On the 2026-10-03 session (rapid products, 3009 epochs) this gives PPS - GPS = -17.5 ns,
sd 9.2 ns, drift -10.8 ns/day, before the uncalibrated antenna/LNA/cable delay.

Usage:
    ppp-vs-utcmike --mike mike2609.gpi --ppp full_output.pos
    ppp-vs-utcmike --fetch 2609 --ppp full_output.pos      # download the MIKES file first
    ppp-vs-utcmike --mike mike2609.gpi --list              # what MJDs does it cover
    ppp-vs-utcmike --timtp tp.csv --clk run.clk --rxclock rx.csv [--fetch 2610]

The last form is the one that measures the pulse: tp.csv from ubx-timtp --csv and rx.csv from
ubx-rxclock --csv, both on the same raw log the PPP run was made from.

The CSRS-PPP side is the .pos file from the full result archive (not the .sum). The clock
column is found by name; pass --ppp-clock-col if the header ever changes.
"""

import argparse
import csv
import datetime
import re
import sys
import urllib.request

GPS_EPOCH = datetime.datetime(1980, 1, 6)
WEEK = 604800
# GPS time runs ahead of UTC by an integer number of seconds (18 since 2017). TIM-TP and the
# tied series are GPS time; MIKES's .gpi files are on the UTC grid, so the two are aligned here
# and nowhere else. Update this if a leap second is ever inserted again.
LEAP_GPS_UTC = 18

BIPM = "https://webtai.bipm.org/ftp/pub/tai/data/{year}/time_transfer/ppp/{name}"


def fetch_mike(yymm, out):
    """Download mikeYYMM.gpi from the BIPM public archive."""
    name = f"mike{yymm}.gpi"
    url = BIPM.format(year=2000 + int(yymm[:2]), name=name)
    print(f"fetching {url}")
    with urllib.request.urlopen(url, timeout=120) as r, open(out, "wb") as f:
        f.write(r.read())
    return out


def read_timtp(path):
    """(gps_datetime, pps_minus_tow_ns) per pulse, from ubx-timtp --csv output.

    `pps_minus_tow_ns` is -qErr: the edge lands earlier than the instant TIM-TP names, which is
    measured rather than assumed — see tools/ubx-timtp.
    """
    rows = []
    with open(path) as handle:
        for rec in csv.DictReader(handle):
            if rec.get("qerr_valid") == "0":
                continue
            when = GPS_EPOCH + datetime.timedelta(weeks=int(rec["week"]), seconds=float(rec["tow_s"]))
            rows.append((when, float(rec["pps_minus_tow_ns"])))
    rows.sort()
    return rows


def read_clk(path, station=None):
    """(gps_datetime, receiver_clock_offset_seconds) from the AR records of a RINEX CLOCK file.

    This is the receiver clock against GPS/IGS time, the same series tools/ppp-clk-adev reads.
    The header says GPS time, but CSRS-PPP tags AR epochs with the observation epochs, which are
    *receiver* time: 00:42:59.991 with a bias of -9.358 ms is GPS 00:43:00.000358. They match
    RAWX rcvTow exactly (3009 of 3011 on 2026-10-03), which is how pps_minus_gps pairs them.
    Neither is UTC, so no leap-second handling is needed here.
    """
    rows = []
    for line in open(path, errors="replace"):
        if not line.startswith("AR "):
            continue
        f = line.split()
        if station and f[1].upper() != station.upper():
            continue
        when = datetime.datetime(int(f[2]), int(f[3]), int(f[4]), int(f[5]), int(f[6])) \
            + datetime.timedelta(seconds=float(f[7]))
        rows.append((when, float(f[9])))
    rows.sort()
    return rows


def interpolate(series, when):
    """Linear interpolation of a sorted (datetime, value) series at `when`; None outside it."""
    if not series or when < series[0][0] or when > series[-1][0]:
        return None
    lo, hi = 0, len(series) - 1
    while hi - lo > 1:
        mid = (lo + hi) // 2
        if series[mid][0] <= when:
            lo = mid
        else:
            hi = mid
    (t0, v0), (t1, v1) = series[lo], series[hi]
    span = (t1 - t0).total_seconds()
    if span <= 0:
        return v0
    return v0 + (v1 - v0) * ((when - t0).total_seconds() / span)


def drift_ns_per_day(points):
    """Least-squares slope of (datetime, ns) in ns/day."""
    if len(points) < 3:
        return 0.0
    t0 = points[0][0]
    xs = [(t - t0).total_seconds() for t, _ in points]
    ys = [v for _, v in points]
    n = len(xs)
    mx, my = sum(xs) / n, sum(ys) / n
    den = sum((x - mx) ** 2 for x in xs)
    if den == 0:
        return 0.0
    return sum((x - mx) * (y - my) for x, y in zip(xs, ys)) / den * 86400


def read_rxclock(path):
    """{receiver-time ms since the GPS epoch: receiver clock bias ns} from ubx-rxclock --csv.

    Keyed by rcvTow, which is what CSRS-PPP's AR epoch tags carry, so the two pair exactly.
    """
    out = {}
    with open(path) as handle:
        for rec in csv.DictReader(handle):
            sec, _, frac = rec["rcv_tow_s"].partition(".")
            ms = int(rec["week"]) * WEEK * 1000 + int(sec) * 1000 + int((frac + "000")[:3])
            out[ms] = int(rec["bias_ns"])
    return out


# Above this the receiver's estimate and PPP's are not describing the same clock with the same
# sign. The real disagreement is tens of ns; a wrong sign or wrong time scale is milliseconds.
TIE_SANITY_NS = 1000.0


def pps_minus_gps(timtp, clk, rxclock):
    """Tie the pulse to GPS time at each PPP clock epoch.

    The receiver places its pulse where *its own* estimate of GPS time says the second falls, then
    misses by qErr. PPP measures the same clock independently. So, with both biases as receiver
    clock - GPS time:

        PPS - GPS  =  (receiver's bias - PPP's bias)  -  qErr

    The TCXO's ms-scale offset and its drift are in both biases and cancel by subtraction; nothing
    is fitted and no sign is chosen. If the two biases differ by more than TIE_SANITY_NS the
    assumption that they describe the same clock in the same convention is broken, and the caller
    refuses to quote a number. See docs/pulse-to-gps-tie.md for how the previous version of this
    function got that wrong.

    The result still contains the antenna, LNA and cable delay minus what CFG-TP-ANT_CABLEDELAY
    compensates, and any receiver-side code bias between the receiver's solution and PPP's.
    """
    qerr_by_sec = {round((when - GPS_EPOCH).total_seconds()): v for when, v in timtp}
    points, no_rx, no_tp = [], 0, 0
    for when_rx, bias_s in clk:
        # AR tags are receiver time on a whole-ms grid; integer ms keeps the arithmetic exact
        rx_ms = (when_rx - GPS_EPOCH) // datetime.timedelta(milliseconds=1)
        own = rxclock.get(rx_ms)
        if own is None:
            no_rx += 1
            continue
        ppp_ns = bias_s * 1e9
        gps_ms = rx_ms - own / 1e6
        pps_tow = qerr_by_sec.get(round(gps_ms / 1000))
        if pps_tow is None:
            no_tp += 1
            continue
        when_gps = GPS_EPOCH + datetime.timedelta(milliseconds=round(gps_ms / 1000) * 1000)
        points.append((when_gps, own - ppp_ns + pps_tow, own - ppp_ns))
    return points, no_rx, no_tp


def read_mike(path):
    """Yield (mjd, seconds_of_day, refgps_ns) from a BIPM PPP (.gpi) file."""
    rows, header = [], {}
    for line in open(path, errors="replace"):
        line = line.rstrip("\r\n")
        if "=" in line and not line.startswith(" "):
            k, _, v = line.partition("=")
            header.setdefault(k.strip(), v.strip())
        f = line.split()
        # PRN 99 marks the all-in-view PPP solution; REFGPS is the last numeric field
        if len(f) >= 6 and f[0] == "99" and f[1].isdigit():
            mjd, hhmmss = int(f[1]), f[2]
            sod = int(hhmmss[:2]) * 3600 + int(hhmmss[2:4]) * 60 + int(hhmmss[4:6])
            try:
                rows.append((mjd, sod, float(f[5])))
            except ValueError:
                continue
    return header, rows


def read_ppp(path, clock_col=None):
    """Yield (mjd, seconds_of_day, clock_ns) from a CSRS-PPP .pos file."""
    rows, cols, idx = [], None, None
    for line in open(path, errors="replace"):
        f = line.split()
        if not f:
            continue
        if cols is None:
            # the header row names the columns; find the receiver clock one
            cand = [i for i, c in enumerate(f) if re.fullmatch(clock_col or r"(RX)?CLK\(?ns\)?|CLK", c, re.I)]
            if cand and any(c.upper().startswith(("YEAR", "DAY", "MJD", "DIR")) for c in f):
                cols, idx = f, cand[0]
            continue
        try:
            mjd, sod = epoch_of(f, cols)
            rows.append((mjd, sod, float(f[idx])))
        except (ValueError, IndexError, KeyError):
            continue
    if cols is None:
        sys.exit("could not find a clock column in the .pos file; pass --ppp-clock-col")
    return rows


def epoch_of(f, cols):
    """Get (mjd, seconds_of_day) from a CSRS-PPP row using its header names."""
    by = {c.upper(): i for i, c in enumerate(cols)}
    for key in ("MJD", "DAYOFYEAR"):
        if key in by:
            break
    hms = next((f[by[k]] for k in ("HR:MN:SS.SS", "HH:MM:SS", "TIME") if k in by), None)
    if hms is None:
        raise KeyError("time column")
    h, m, s = (float(x) for x in hms.split(":"))
    sod = int(h * 3600 + m * 60 + s)
    if "MJD" in by:
        return int(float(f[by["MJD"]])), sod
    # else derive MJD from YEAR + DAYOFYEAR
    import datetime
    y = int(float(f[by["YEAR"]])); doy = int(float(f[by["DAYOFYEAR"]]))
    d = datetime.date(y, 1, 1) + datetime.timedelta(days=doy - 1)
    return d.toordinal() - 678576, sod


def mjd_of(when):
    """MJD of a GPS-time datetime, converted to UTC first: MIKES files are on the UTC grid."""
    utc = when - datetime.timedelta(seconds=LEAP_GPS_UTC)
    return utc.toordinal() - 678576


def sod_of(when):
    utc = when - datetime.timedelta(seconds=LEAP_GPS_UTC)
    return utc.hour * 3600 + utc.minute * 60 + utc.second


def pair(ours, theirs, tol=15):
    """Match our epochs to theirs within tol seconds."""
    theirs_by = {(m, s): v for m, s, v in theirs}
    out = []
    for m, s, v in ours:
        for d in range(0, tol + 1):
            for cand in ((m, s - d), (m, s + d)):
                if cand in theirs_by:
                    out.append((m, s, v, theirs_by[cand]))
                    break
            else:
                continue
            break
    return out


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--mike", help="BIPM PPP file (mikeYYMM.gpi)")
    p.add_argument("--fetch", metavar="YYMM", help="download that month's MIKES file first")
    p.add_argument("--ppp", help="CSRS-PPP .pos file from the full result archive (ignored with --timtp)")
    p.add_argument("--ppp-clock-col", help="regex for the clock column name in the .pos header")
    p.add_argument("--timtp", help="TIM-TP CSV from ubx-timtp --csv; ties the pulse to the receiver clock")
    p.add_argument("--clk", help="RINEX CLOCK file from the PPP archive (AR records), used with --timtp")
    p.add_argument("--rxclock", help="receiver's own clock estimate from ubx-rxclock --csv, used with --timtp")
    p.add_argument("--station", help="station id to select in the .clk file")
    p.add_argument("--list", action="store_true", help="just report what the MIKES file covers")
    a = p.parse_args()

    path = a.mike
    if a.fetch:
        path = path or f"mike{a.fetch}.gpi"
        fetch_mike(a.fetch, path)
    if not path and not a.timtp:
        sys.exit("need --mike or --fetch, or --timtp to compute our own side alone")

    header, theirs, mjds = {}, [], []
    if path:
        header, theirs = read_mike(path)
        mjds = sorted({m for m, _, _ in theirs})
        if not theirs:
            sys.exit(f"{path}: no PRN 99 rows parsed -- is this a BIPM PPP .gpi file?")
        print(f"{path}: {len(theirs)} rows, MJD {mjds[0]}..{mjds[-1]}, "
              f"REF={header.get('REF', '?')}, {header.get('COMMENTS', '')[:60]}")
        print(f"  their delays: INT {header.get('INT DLY', '?')} | CAB {header.get('CAB DLY', '?')} | "
              f"REF {header.get('REF DLY', '?')}")
        if a.list:
            return
    if not a.ppp and not a.timtp:
        return

    if a.timtp:
        if not a.clk or not a.rxclock:
            sys.exit("--timtp needs --clk, the RINEX CLOCK file from the same PPP run, and --rxclock,\n"
                     "the receiver's own clock estimate from ubx-rxclock on the same raw log")
        timtp = read_timtp(a.timtp)
        clk = read_clk(a.clk, a.station)
        rxclock = read_rxclock(a.rxclock)
        if not timtp or not clk or not rxclock:
            sys.exit(f"nothing to tie: {len(timtp)} TIM-TP rows, {len(clk)} AR records, "
                     f"{len(rxclock)} receiver clock rows")
        print(f"{a.timtp}: {len(timtp)} pulses, {timtp[0][0]} .. {timtp[-1][0]} (GPS time)")
        print(f"{a.clk}: {len(clk)} AR records, receiver clock "
              f"{clk[0][1]*1e6:+.1f} .. {clk[-1][1]*1e6:+.1f} us")
        print(f"{a.rxclock}: {len(rxclock)} epochs of the receiver's own clock estimate")
        tied, no_rx, no_tp = pps_minus_gps(timtp, clk, rxclock)
        if not tied:
            sys.exit("no overlap between the pulses, the receiver clock and the PPP clock")
        print(f"  paired {len(tied)} PPP epochs ({no_rx} without a receiver estimate, "
              f"{no_tp} without a pulse)")
        disagree = sorted(d for _, _, d in tied)
        median = disagree[len(disagree) // 2]
        print(f"\nreceiver's clock bias - PPP's: median {median:+.1f} ns")
        if abs(median) > TIE_SANITY_NS:
            sys.exit(f"\nThe two clock estimates differ by {median/1e3:+.1f} us, not tens of ns. They are\n"
                     f"not describing the same clock in the same convention -- a sign, a time scale, or\n"
                     f"the wrong station's AR records. Not quoting a number.")
        vals = [v for _, v, _ in tied]
        mean = sum(vals) / len(vals)
        sd = (sum((v - mean) ** 2 for v in vals) / len(vals)) ** 0.5
        drift = drift_ns_per_day([(t, v) for t, v, _ in tied])
        print(f"\nPPS - GPS time: {len(tied)} epochs, mean {mean:+.1f} ns, sd {sd:.1f} ns, "
              f"standard error {sd / len(vals) ** 0.5:.1f} ns, drift {drift:+.1f} ns/day")
        print("That is this station's pulse against GPS time as PPP realises it. It still contains")
        print("the antenna, LNA and cable delay minus what CFG-TP-ANT_CABLEDELAY compensates, and")
        print("any receiver code bias PPP does not model. Differencing against MIKES below removes")
        print("the satellite errors common to both, not our own hardware delays. The standard")
        print("error assumes white noise and the series is not white; treat it as a floor.")
        ours = [(mjd_of(t), sod_of(t), v) for t, v, _ in tied]
    else:
        ours = read_ppp(a.ppp, a.ppp_clock_col)
        if not ours:
            sys.exit("no epochs parsed from the .pos file")
        print(f"{a.ppp}: {len(ours)} epochs, MJD {min(m for m, _, _ in ours)}..{max(m for m, _, _ in ours)}")
        print("\nWARNING: without --timtp this differences the receiver's free-running TCXO")
        print("against UTC(MIKE), which measures our crystal and not our timing output.")

    if not theirs:
        print("\nNo MIKES file given, so our side is computed and nothing is compared. The")
        print("BIPM publishes mikeYYMM.gpi a couple of weeks after each month ends; pass it")
        print("with --mike, or --fetch YYMM, once the month in question is available.")
        return

    both = pair(ours, theirs)
    if not both:
        sys.exit("no overlapping epochs — is the MIKES month right for these MJDs?")

    diffs = [o - t for _, _, o, t in both]
    diffs.sort()
    n = len(diffs)
    mean = sum(diffs) / n
    sd = (sum((d - mean) ** 2 for d in diffs) / n) ** 0.5
    print(f"\nmatched {n} epochs")
    print(f"our clock - UTC(MIKE):  mean {mean:+.1f} ns  sd {sd:.1f} ns  "
          f"median {diffs[n // 2]:+.1f}  min {diffs[0]:+.1f}  max {diffs[-1]:+.1f}")
    print("\nThat mean includes our uncompensated antenna, LNA, cable and receiver delays,")
    print("and says nothing about the time pulse's own edge. See docs/timing.md.")


if __name__ == "__main__":
    main()
