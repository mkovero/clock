#!/usr/bin/env python3
"""ubx-timtp -- extract UBX-TIM-TP records from a raw .ubx log.

    ubx-timtp <log.ubx> [--csv out.csv] [--all]

TIM-TP is what turns a PPP session into a time-transfer session: it reports, once per pulse,
which GNSS-time instant the pulse was aimed at and how far the hardware missed by. Without it
the PPP clock series describes only the receiver's free-running TCXO, which is useless for
comparing our output against anyone else's (see docs/timing.md).

Payload, 16 bytes, class 0x0d id 0x01:

    towMS    U4   ms        time of week of the pulse, in the configured time base
    towSubMS U4   2^-32 ms  sub-millisecond part
    qErr     I4   ps        quantisation error of that pulse
    week     U2   weeks     GNSS week number of the pulse
    flags    X1             bit0 timeBase (0 GNSS, 1 UTC), bit1 UTC available,
                            bits2-3 RAIM, bit4 qErrInvalid
    refInfo  X1             bits0-3 time reference GNSS (0 GPS, 1 GLONASS, 2 BeiDou,
                            3 Galileo), bits4-7 UTC standard

**Sign convention.** The pulse is emitted close to the instant `towMS + towSubMS` names, and
`qErr` is how far off the hardware's clock grid forced it. Measured on this station rather than
assumed: with ts2phc stopped, the PHY's own timestamp of the pulse regresses against qErr with
slope -0.955 +/- 0.209 (docs/timing.md), i.e. the edge lands **earlier** by qErr. So

    true pulse epoch = tow - qErr

and that is what `--csv` writes as `pps_minus_tow_ns = -qErr`. If a future receiver or firmware
inverts this, the regression above is the test that catches it.

Records with `qErrInvalid` set, or a bad checksum, are dropped and counted. By default only
records usable for time transfer are emitted; `--all` keeps the rest with a `usable` column.
"""

import struct
import sys

CLS, MID, PAYLOAD_LEN = 0x0D, 0x01, 16
GPS_EPOCH_WEEK_SECS = 604800


def checksum(buf):
    """Fletcher-8 over class, id, length and payload."""
    a = b = 0
    for byte in buf:
        a = (a + byte) & 0xFF
        b = (b + a) & 0xFF
    return a, b


def records(data):
    """Yield verified UBX-TIM-TP payloads from a raw stream."""
    i, bad_sum, wrong_len = 0, 0, 0
    n = len(data)
    while True:
        i = data.find(b"\xb5\x62", i)
        if i < 0 or i + 8 > n:
            break
        cls, mid, length = data[i + 2], data[i + 3], int.from_bytes(data[i + 4:i + 6], "little")
        end = i + 6 + length
        if end + 2 > n:
            break
        if (cls, mid) != (CLS, MID):
            i += 2
            continue
        body = data[i + 2:end]
        if (data[end], data[end + 1]) != checksum(body):
            bad_sum += 1
            i += 2
            continue
        if length != PAYLOAD_LEN:
            wrong_len += 1
            i += 2
            continue
        yield data[i + 6:end]
        i = end + 2
    records.bad_sum, records.wrong_len = bad_sum, wrong_len


def parse(payload):
    tow_ms, tow_sub, qerr_ps, week, flags, refinfo = struct.unpack("<IIiHBB", payload)
    return {
        "week": week,
        # tow_sub is in 2^-32 ms; keep the full resolution, it is sub-picosecond
        "tow_s": tow_ms / 1000.0 + tow_sub / 2**32 / 1000.0,
        "qerr_ns": qerr_ps / 1000.0,
        "time_base": "UTC" if flags & 0x01 else "GNSS",
        "utc_avail": bool(flags & 0x02),
        "raim": (flags >> 2) & 0x03,
        "qerr_valid": not (flags & 0x10),
        "ref_gnss": {0: "GPS", 1: "GLONASS", 2: "BeiDou", 3: "Galileo"}.get(refinfo & 0x0F, refinfo & 0x0F),
        "flags": flags,
        "refinfo": refinfo,
    }


def main():
    argv = sys.argv[1:]
    if not argv:
        sys.exit(__doc__)
    path = argv[0]
    keep_all = "--all" in argv
    out = argv[argv.index("--csv") + 1] if "--csv" in argv else None

    rows = [parse(p) for p in records(open(path, "rb").read())]
    if not rows:
        sys.exit(f"{path}: no TIM-TP records "
                 f"(bad checksum {records.bad_sum}, wrong length {records.wrong_len}) -- "
                 f"was CFG-MSGOUT-UBX_TIM_TP_UART1 enabled while logging?")

    usable = [r for r in rows if r["qerr_valid"]]
    weeks = sorted({r["week"] for r in rows})
    bases = sorted({r["time_base"] for r in rows})
    gnss = sorted({str(r["ref_gnss"]) for r in rows})
    # Fold the week number in: a session that crosses a GPS week boundary (Saturday
    # midnight UTC) has tow_s wrap to zero, and comparing tow alone then reports a
    # bogus span of a whole week and an equally bogus 5.9-day "gap".
    secs = sorted(r["week"] * GPS_EPOCH_WEEK_SECS + r["tow_s"] for r in rows)
    span = secs[-1] - secs[0]

    print(f"{path}: {len(rows)} TIM-TP records, {len(usable)} with qErr valid")
    print(f"  week {weeks if len(weeks) < 4 else f'{weeks[0]}..{weeks[-1]}'}  "
          f"span {span/3600:.2f} h  time base {','.join(bases)}  reference {','.join(gnss)}")
    print(f"  dropped: {records.bad_sum} bad checksum, {records.wrong_len} wrong length")
    qs = [r["qerr_ns"] for r in usable]
    if qs:
        qs_sorted = sorted(qs)
        mean = sum(qs) / len(qs)
        sd = (sum((q - mean) ** 2 for q in qs) / len(qs)) ** 0.5
        print(f"  qErr: {qs_sorted[0]:+.2f} .. {qs_sorted[-1]:+.2f} ns, "
              f"mean {mean:+.3f} ns, sd {sd:.2f} ns")
    raims = sorted({r["raim"] for r in rows})
    if raims != [2]:
        print(f"  note: RAIM state(s) {raims} (2 = active); 0 means not available")
    if len(bases) > 1 or len(gnss) > 1:
        print("  WARNING: the time base or reference GNSS changed mid-log; "
              "the pulse moved between time scales and the series is not continuous")

    # a 1 Hz pulse should give one record per second; gaps mean the message was off
    gaps = [(b - a) for a, b in zip(secs, secs[1:]) if b - a > 1.5]
    if gaps:
        print(f"  {len(gaps)} gaps totalling {sum(gaps):.0f} s "
              f"(largest {max(gaps):.0f} s) -- those seconds have no pulse/clock tie")

    if out:
        with open(out, "w") as f:
            f.write("week,tow_s,qerr_ns,pps_minus_tow_ns,ref_gnss,time_base,raim,qerr_valid\n")
            for r in (rows if keep_all else usable):
                f.write(f"{r['week']},{r['tow_s']:.9f},{r['qerr_ns']:.3f},"
                        f"{-r['qerr_ns']:.3f},{r['ref_gnss']},{r['time_base']},"
                        f"{r['raim']},{int(r['qerr_valid'])}\n")
        print(f"wrote {out} ({len(rows if keep_all else usable)} rows)")


if __name__ == "__main__":
    main()
